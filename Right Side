       //robot.backLeft.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
       //robot.backRight.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
       robot.lift.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
       robot.lift.setPower(1);
       robot.lift.setTargetPosition(0);
       robot.lift.setMode(DcMotor.RunMode.RUN_TO_POSITION);


       //initializes the camera and sets it up for which camera will be used.
       WebcamName webcamName = hardwareMap.get(WebcamName.class, "camera");
       camera = OpenCvCameraFactory.getInstance().createWebcam(webcamName);
       pipeline = new AprilTagDetectionPipeline(tagsize, fx, fy, cx, cy);
       camera.setPipeline(pipeline);

       // We set the viewport policy to optimized view so the preview doesn't appear 90 deg
       // out when the RC activity is in portrait. We do our actual image processing assuming
       // landscape orientation, though.
       camera.setViewportRenderingPolicy(OpenCvCamera.ViewportRenderingPolicy.OPTIMIZE_VIEW);

       camera.openCameraDeviceAsync(new OpenCvCamera.AsyncCameraOpenListener() {

           @Override
           public void onOpened() {
               camera.startStreaming(1280, 720, OpenCvCameraRotation.UPRIGHT);
           }

           @Override
           public void onError(int errorCode) {
           }
       });

       detection detectionResult = detection.DETECTION_FAILED;

       Pose2d myPose = new Pose2d(10, -5, Math.toRadians(90));
       SampleMecanumDrive drive = new SampleMecanumDrive(hardwareMap);
       drive.setPoseEstimate(myPose);

       TrajectorySequence trajec1 = drive.trajectorySequenceBuilder(myPose)
               .forward(2)
               .strafeLeft(15)
               .addTemporalMarker(0, () -> {
                   robot.lift.setTargetPosition(200);
               })
               .forward(3)
               .waitSeconds(2)
               .addTemporalMarker(2, () -> {
                   robot.lift.setTargetPosition(4700);
               })
               .forward(3)
               .build();

       TrajectorySequence trajec2 = drive.trajectorySequenceBuilder(trajec1.end())
                       .back(5)
               .waitSeconds(1)
                               .addTemporalMarker(0.5,()->{
                                   robot.lift.setTargetPosition(200);
                               })
               .strafeRight(14)
               .waitSeconds(0.6)
               .forward(52)
               .back(3)


               .build();

       TrajectorySequence trajec3 = drive.trajectorySequenceBuilder(trajec2.end())
               .turn(Math.toRadians(-90))
               .waitSeconds(0.3)
               .forward(10)
               .waitSeconds(0.1)
               .forward(14)
               .addTemporalMarker(1, ()->{
                   robot.lift.setTargetPosition(1400);
               })
               .build();

       TrajectorySequence trajec4 = drive.trajectorySequenceBuilder(trajec3.end())

                       .addTemporalMarker(0.1, ()->{
                           robot.lift.setTargetPosition(3000);
                       })
               .waitSeconds(1)


                       .back(25)
               .waitSeconds(0.2)
               .strafeRight(15)
               .addTemporalMarker(3, ()->{
                   robot.lift.setTargetPosition(4700);
               })
               .forward(3)
               .build();

       TrajectorySequence trajec5 = drive.trajectorySequenceBuilder(trajec4.end())
               .back(2)
               .strafeLeft(14)
               .back(21)
               .addTemporalMarker(1.2,()->{
                   robot.lift.setTargetPosition(1350);
               })
               .build();

       TrajectorySequence trajec6 = drive.trajectorySequenceBuilder(trajec4.end())
               .back(2)
               .strafeLeft(13)
               .addTemporalMarker(1.2,()->{
                   robot.lift.setTargetPosition(1350);
               })
               .back(4)
               .build();

       TrajectorySequence trajec7 = drive.trajectorySequenceBuilder(trajec4.end())
               .back(2)
               .strafeLeft(13)
               .addTemporalMarker(1.2,()->{
                   robot.lift.setTargetPosition(1350);
               })
               .forward(21)
               .build();









       while (!isStarted()) {
           ArrayList<AprilTagDetection> detections = pipeline.getDetectionsUpdate();


           // If there's been a new frame...
           if (detections != null) {
               telemetry.addData("FPS", camera.getFps());
               telemetry.addData("Overhead ms", camera.getOverheadTimeMs());
               telemetry.addData("Pipeline ms", camera.getPipelineTimeMs());
               if (detectionResult == detection.LEFT) {
                   telemetry.addLine("Plan: Left Side");
               } else if (detectionResult == detection.RIGHT) {
                   telemetry.addLine("Plan: Right Side");
               } else {
                   telemetry.addLine("Plan: Middle Side");
               }

               // If we don't see any tags
               if (detections.size() == 0) {
                   numFramesWithoutDetection++;

                   // If we haven't seen a tag for a few frames, lower the decimation
                   // so we can hopefully pick one up if we're e.g. far back
                   if (numFramesWithoutDetection >= THRESHOLD_NUM_FRAMES_NO_DETECTION_BEFORE_LOW_DECIMATION) {
                       pipeline.setDecimation(DECIMATION_LOW);
                   }
               }
               // We do see tags!
               else {
                   numFramesWithoutDetection = 0;

                   // If the target is within 1 meter, turn on high decimation to
                   // increase the frame rate
                   if (detections.get(0).pose.z < THRESHOLD_HIGH_DECIMATION_RANGE_METERS) {
                       pipeline.setDecimation(DECIMATION_HIGH);
                   }

                   if (detections.get(0).id == 1) {
                       detectionResult = detection.LEFT;
                   } else if (detections.get(0).id == 2) {
                       detectionResult = detection.MIDDLE;
                   } else if (detections.get(0).id == 3) {
                       detectionResult = detection.RIGHT;
                   }

                   for (AprilTagDetection detection : detections) {
                       telemetry.addLine(String.format("\nDetected tag ID=%d", detection.id));
                   }
                   if (detectionResult == detection.LEFT) {
                       telemetry.addLine("Left Side");
                   } else if (detectionResult == detection.MIDDLE) {
                       telemetry.addLine("Middle Side");
                   } else if (detectionResult == detection.RIGHT) {
                       telemetry.addLine("Right Side");
                   }
               }

               telemetry.update();
           }
       }

       waitForStart();


       if (detectionResult == detection.LEFT) {

           robot.claw.setPosition(1);
           sleep(300);
           drive.followTrajectorySequence(trajec1);
           sleep(300);
           robot.claw.setPosition(0.7);
           sleep(400);
           drive.followTrajectorySequence(trajec2);
           sleep(400);
           drive.followTrajectorySequence(trajec3);
           robot.claw.setPosition(1);
           sleep(300);
           drive.followTrajectorySequence(trajec4);
           robot.claw.setPosition(0.7);
           sleep(300);
