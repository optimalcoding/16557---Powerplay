           // sleep(500);
           // straight(0.5,930);


       } else if (detectionResult == detection.MIDDLE) { //starting right side

           robot.claw.setPosition(1);
           sleep(400);
           drive.followTrajectorySequence(trajec1);
           sleep(200);
           robot.claw.setPosition(0.7);
           sleep(300);
           drive.followTrajectorySequence(trajec2);
           sleep(100);
           drive.followTrajectorySequence(trajec3);
           robot.claw.setPosition(1);
           sleep(400);
           drive.followTrajectorySequence(trajec4);
           robot.claw.setPosition(0.7);
           sleep(400);
           drive.followTrajectorySequence(trajec6);

          // grab(1, 500);
          // sleep(250);
          // arm(-1, 200);
          // sleep(100);
          // strafeLeft(0.5, 750);
          // sleep(100);
          // arm(-1, 1700);
          // sleep(250);
          // straight(0.25, 600);
          // sleep(250);
          // grab(0.7, 200);
          // sleep(250);
          // straight(-0.25, 250);
          // sleep(250);
          // grab(1, 200);
          // sleep(250);
          // arm(1, 1350);
          // sleep(500);
          // strafeRight(0.5, 650);
          // sleep(250);
          // grab(0, 200);
          // straight(0.3, 3200);
          // sleep(100);
          // straight(-0.3, 300);
          // sleep(500);
          // rotate(0.5, 700);

// non roadrunner backup probably if I can find a way to get it to run standby unless necessary

       } else if (detectionResult == detection.RIGHT) { //starting right side
           robot.claw.setPosition(1);
           sleep(400);
           drive.followTrajectorySequence(trajec1);
           sleep(200);
           robot.claw.setPosition(0.7);
           sleep(300);
           drive.followTrajectorySequence(trajec2);
           sleep(100);
           drive.followTrajectorySequence(trajec3);
           robot.claw.setPosition(1);
           sleep(400);
           drive.followTrajectorySequence(trajec4);
           robot.claw.setPosition(0.7);
           sleep(400);
           drive.followTrajectorySequence(trajec7);


// going to be our backup for right side
          // grab(1, 200);
          // sleep(500);
          // arm(1, 200);
